<!DOCTYPE html>
<html lang="ar" dir="ltr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>طالبة اعدادية تفرك</title>

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
.player-container,
#customVideo,
.progress-area,
.progress-bar {
  direction: ltr !important;
}

:root {
--main-accent: #ff0050;
--glass-bg: rgba(255,255,255,0.05);
--dark-bg:#08080a;
--card-radius:20px;
--text-muted:#808085;
}

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}

body{
font-family:'Cairo',sans-serif;
margin:0;
background-color:var(--dark-bg);
color:#fff;
display:flex;
flex-direction:column;
align-items:center;
min-height:100vh;
background-image:radial-gradient(circle at 50% -20%,#2a0f18 0%,#08080a 60%);
}

body::before{
content:"";
position:fixed;
top:0;left:0;width:100%;height:100%;
background-image:radial-gradient(rgba(255,255,255,0.05) 1.5px,transparent 1.5px);
background-size:25px 25px;
z-index:-1;
}

header{
width:100%;
padding:20px;
display:flex;
justify-content:space-between;
align-items:center;
max-width:800px;
}

.back-btn{
color:#fff;
text-decoration:none;
font-size:14px;
display:flex;
align-items:center;
gap:8px;
background:var(--glass-bg);
padding:8px 15px;
border-radius:12px;
border:1px solid rgba(255,255,255,0.05);
transition:0.3s;
}

.back-btn:hover{background:rgba(255,255,255,0.1);}

.player-container {
  width: 95%;
  max-width: 800px;
  margin-top: 10px;
  position: relative;
  border-radius: var(--card-radius);
  overflow: hidden;
  background: #000;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 0, 80, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.05);
  aspect-ratio: 16/9;
}

#customVideo {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  cursor: pointer;
  background: black;
}

/* زر التشغيل الكبير */

.big-play-btn{
position:absolute;
top:50%;
left:50%;
transform:translate(-50%,-50%);
width:90px;
height:90px;
border-radius:50%;
background:rgba(0,0,0,0.65);
display:flex;
align-items:center;
justify-content:center;
font-size:36px;
color:#fff;
cursor:pointer;
transition:0.3s;
backdrop-filter:blur(6px);
}

.big-play-btn:hover{
background:#ff0050;
transform:translate(-50%,-50%) scale(1.1);
}

/* preview */

.preview-box{
position:absolute;
bottom:35px;
width:160px;
height:90px;
background:#000;
border-radius:6px;
overflow:hidden;
display:none;
pointer-events:none;
border:1px solid rgba(255,255,255,0.1);
}

.preview-box video{
width:100%;
height:100%;
object-fit:cover;
}

.controls-overlay{
position:absolute;
bottom:0;
left:0;
right:0;
background:linear-gradient(transparent,rgba(0,0,0,0.9));
padding:20px;
display:flex;
flex-direction:column;
gap:10px;
opacity:0;
transition:opacity 0.3s;
}

.player-container:hover .controls-overlay{opacity:1;}


.progress-area{
width:100%;
height:5px;
background:rgba(255,255,255,0.1);
border-radius:10px;
cursor:pointer;
position:relative;
}

.progress-bar{
height:100%;
width:0%;
background:var(--main-accent);
border-radius:10px;
box-shadow:0 0 10px var(--main-accent);
}

.buttons-row{
display:flex;
justify-content:space-between;
align-items:center;
}

.left-controls,.right-controls{
display:flex;
align-items:center;
gap:20px;
}

.control-btn{
background:none;
border:none;
color:#fff;
font-size:18px;
cursor:pointer;
transition:0.2s;
}

.control-btn:hover{color:var(--main-accent);transform:scale(1.1);}

.time-display{
font-size:12px;
font-weight:600;
color:#ddd;
font-family:monospace;
}

.video-details{
width:95%;
max-width:800px;
padding:25px 10px;
animation:fadeInUp 0.8s ease;
}

@keyframes fadeInUp{
from{opacity:0;transform:translateY(20px);}
to{opacity:1;transform:translateY(0);}
}

.v-badge-row{display:flex;gap:10px;margin-bottom:12px;}

.v-badge{
font-size:11px;
font-weight:800;
padding:4px 12px;
border-radius:6px;
text-transform:uppercase;
}

.badge-premium{background:var(--main-accent);color:white;}
.badge-quality{border:1px solid #333;color:#888;}

.v-full-title{
font-size:22px;
font-weight:800;
margin:0 0 10px 0;
background:linear-gradient(to left,#fff,#888);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
}

.download-section{
width:95%;
max-width:800px;
margin-bottom:50px;
}

.dl-btn{
width:100%;
padding:18px;
border-radius:15px;
background:linear-gradient(45deg,#1a1a1c,#0d0d0f);
border:1px solid rgba(255,0,80,0.2);
color:#fff;
font-weight:700;
display:flex;
justify-content:center;
align-items:center;
gap:12px;
cursor:pointer;
transition:0.3s;
text-decoration:none;
}

.dl-btn:hover{
border-color:var(--main-accent);
box-shadow:0 10px 30px rgba(255,0,80,0.15);
transform:translateY(-3px);
}
body {
  direction: ltr !important;
}
</style>
</head>

<body>
  

<header>
<div class="logo" style="font-weight:800;font-size:19px;background:linear-gradient(to left,#fff,var(--main-accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Sex 1 iraq</div>

<a href="https://sex1iraqi.site/" class="back-btn">
<i class="fas fa-arrow-right"></i>
الرجوع لصفحة الرئيسية
</a>
</header>

<div class="player-container" id="videoPlayer">

<video id="customVideo" poster="https://sex1iraqi.site/wp-content/uploads/2026/03/1.jpg">
<source src="https://sex1iraqi.site/wp-content/uploads/2026/03/VID_20260301_232441_007.mp4" type="video/mp4">
</video>

<div class="big-play-btn" id="bigPlay">
<i class="fas fa-play"></i>
</div>

<div class="controls-overlay">

<div class="progress-area" id="progressArea">
<div class="progress-bar" id="progressBar"></div>

<div class="preview-box" id="previewBox">
<video id="previewVideo" muted>
<source src="https://sex1iraqi.site/wp-content/uploads/2026/03/VID_20260301_232441_007.mp4">
</video>
</div>

</div>

<div class="buttons-row">
<div class="left-controls">

<button class="control-btn" id="playPause">
<i class="fas fa-play"></i>
</button>

<div class="time-display">
<span id="currentTime">0:00</span> /
<span id="duration">0:00</span>
</div>

</div>

<div class="right-controls">

<button class="control-btn" id="volumeBtn">
<i class="fas fa-volume-up"></i>
</button>

<button class="control-btn" id="fullScreenBtn">
<i class="fas fa-expand"></i>
</button>

</div>
</div>

</div>
</div>

<div class="video-details">

<div class="v-badge-row">
<span class="v-badge badge-premium">عرض حصري</span>
<span class="v-badge badge-quality">4K Ultra HD</span>
</div>

<h1 class="v-full-title">طالبة اعدادية تفرك</h1>

<div class="download-section">

<a href="https://sex1iraqi.site/wp-content/uploads/2026/03/VID_20260301_232441_007.mp4" download class="dl-btn">
<i class="fas fa-cloud-download-alt"></i>
تحميل الفيديو بجودة عالية
</a>

</div>
</div>

<script>

const video=document.getElementById('customVideo');
const playerContainer=document.getElementById('videoPlayer');
const playPauseBtn=document.getElementById('playPause');
const progressArea=document.getElementById('progressArea');
const progressBar=document.getElementById('progressBar');
const fullScreenBtn=document.getElementById('fullScreenBtn');
const currentTimeEl=document.getElementById('currentTime');
const durationEl=document.getElementById('duration');
const volumeBtn=document.getElementById('volumeBtn');

const bigPlay=document.getElementById("bigPlay");
const previewBox=document.getElementById("previewBox");
const previewVideo=document.getElementById("previewVideo");

function togglePlay(){

if(video.paused){
video.play();
playPauseBtn.innerHTML='<i class="fas fa-pause"></i>';
bigPlay.style.display="none";
}else{
video.pause();
playPauseBtn.innerHTML='<i class="fas fa-play"></i>';
bigPlay.style.display="flex";
}

}

playPauseBtn.addEventListener('click',togglePlay);
video.addEventListener('click',togglePlay);
bigPlay.addEventListener('click',togglePlay);

video.addEventListener('timeupdate',()=>{
const percent=(video.currentTime/video.duration)*100;
progressBar.style.width=`${percent}%`;
currentTimeEl.textContent=formatTime(video.currentTime);
});

video.addEventListener('loadedmetadata',()=>{
durationEl.textContent=formatTime(video.duration);
});

let isDragging = false;

function updateProgress(positionX) {
  const rect = progressArea.getBoundingClientRect();
  
  // نعتبر البداية دائماً من اليسار
  let pos = positionX - rect.left;
  
  // تحديد حدود الشريط
  if (pos < 0) pos = 0;
  if (pos > rect.width) pos = rect.width;
  
  const percent = pos / rect.width;
  
  // تحديث شريط التقدم والفيديو
  progressBar.style.width = (percent * 100) + "%";
  video.currentTime = percent * video.duration;
  
  // معاينة الفيديو
  previewBox.style.display = "block";
  previewBox.style.left = (pos - 80) + "px";
  previewVideo.currentTime = percent * video.duration;
}

progressArea.addEventListener("mousedown", (e) => {
  isDragging = true;
  updateProgress(e.clientX);
});

document.addEventListener("mousemove", (e) => {
  if (isDragging) {
    updateProgress(e.clientX);
  }
});

document.addEventListener("mouseup", () => {
  isDragging = false;
  previewBox.style.display = "none";
});

/* دعم الهاتف */

progressArea.addEventListener("touchstart", (e) => {
  isDragging = true;
  updateProgress(e.touches[0].clientX);
});

document.addEventListener("touchmove", (e) => {
  if (isDragging) {
    updateProgress(e.touches[0].clientX);
  }
});

document.addEventListener("touchend", () => {
  isDragging = false;
  previewBox.style.display = "none";
});

/* preview */

progressArea.addEventListener("mousemove",(e)=>{

const rect=progressArea.getBoundingClientRect();
const pos=e.clientX-rect.left;

const percent=pos/rect.width;

previewBox.style.display="block";
previewBox.style.left=(pos-80)+"px";

previewVideo.currentTime=percent*video.duration;

});

progressArea.addEventListener("mouseleave",()=>{
previewBox.style.display="none";
});

fullScreenBtn.addEventListener('click',()=>{

if(!document.fullscreenElement){

playerContainer.requestFullscreen();
fullScreenBtn.innerHTML='<i class="fas fa-compress"></i>';

}else{

document.exitFullscreen();
fullScreenBtn.innerHTML='<i class="fas fa-expand"></i>';

}

});

volumeBtn.addEventListener('click',()=>{
video.muted=!video.muted;
volumeBtn.innerHTML=video.muted ? '<i class="fas fa-volume-mute"></i>' : '<i class="fas fa-volume-up"></i>';
});

function formatTime(time){
const min=Math.floor(time/60);
const sec=Math.floor(time%60);
return `${min}:${sec<10?'0'+sec:sec}`;
}

</script>

</body>
</html>
